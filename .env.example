# Copy to .env and choose the absolute folder containing your media.
# Windows example: C:/Users/your-name/Pictures
LUMA_MEDIA_PATH=/absolute/path/to/photos
# Use false when the source filesystem is case-insensitive (e.g. normal NTFS).
LUMA_CASE_SENSITIVE=true
# Initial indexing is opt-in. Set true only when every configured library should
# be scanned automatically when Luma starts.
LUMA_SCAN_ON_STARTUP=false
